--======================= CORES =======================
local C_ON      = Color3.fromRGB(80, 255, 140)
local C_OFF     = Color3.fromRGB(255, 60, 60)
local C_BG_ON   = Color3.fromRGB(18, 40, 25)
local C_BG_OFF  = Color3.fromRGB(25, 25, 25)

--======================= ANIMAÇÃO =======================
local PulseT = 0
RunService.RenderStepped:Connect(function(dt)
    PulseT += dt
    local base = (math.sin(PulseT * 3) + 1) * 0.5
    local targetColor = VoidM1Enabled and C_ON or C_OFF

    stroke.Color = targetColor
    glow.Color   = targetColor
    dot.BackgroundColor3 = targetColor

    glow.Transparency   = 0.55 + base * 0.25
    stroke.Transparency = 0.15 + base * 0.2
    dotStroke.Transparency = 0.4 + base * 0.3

    Button.BackgroundColor3 = Button.BackgroundColor3:Lerp(
        VoidM1Enabled and C_BG_ON or C_BG_OFF, math.min(dt * 6, 1)
    )
end)

--======================= TOGGLE =======================
local function Toggle()
    VoidM1Enabled = not VoidM1Enabled
    label.Text = VoidM1Enabled and "FRUIT VOID · ON" or "FRUIT VOID"
    SetVoidFruitM1Enabled(VoidM1Enabled)
end

-- TextButton já dispara Activated pra mouse E touch automaticamente
Hitbox.Activated:Connect(Toggle)

--======================= ARRASTAR (opcional) =======================
local dragging, dragStart, startPos = false, nil, nil

Hitbox.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        -- se segurar e mover > 6px, vira drag; senão é clique (o Activated cuida)
        dragging = true
        dragStart = input.Position
        startPos = Hitbox.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                     or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        if math.abs(delta.X) > 6 or math.abs(delta.Y) > 6 then
            Hitbox.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
